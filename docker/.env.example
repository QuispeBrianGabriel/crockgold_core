# Copiar a .env junto a compose.yml (ignorado por git): cp docker/.env.example docker/.env

POSTGRES_DB=crockgold
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# GID del grupo docker del host (`stat -c %g /var/run/docker.sock`), para Testcontainers
DOCKER_GID=999

# Credencial HTTP Basic de la API en local
SPRING_SECURITY_USER_NAME=dev
SPRING_SECURITY_USER_PASSWORD=change-me
