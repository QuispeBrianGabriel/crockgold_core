# Copiar a .env (ignorado por git): cp .env.example .env

# --- PostgreSQL (contenedor db) ---
POSTGRES_DB=crockgold
POSTGRES_USER=crockgold
POSTGRES_PASSWORD=change-me

# --- Spring Boot (contenedor api) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/crockgold
SPRING_DATASOURCE_USERNAME=crockgold
SPRING_DATASOURCE_PASSWORD=change-me
TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal

# GID del grupo docker del host (`stat -c %g /var/run/docker.sock`), para Testcontainers
DOCKER_GID=999
