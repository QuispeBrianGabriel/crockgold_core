{
  "dockerComposeFile": "../compose.yml",
  "service": "api",
  "workspaceFolder": "/app",
  "mounts": [
    "source=claude-config,target=/home/ubuntu/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/ubuntu/.claude"
  },
  "postCreateCommand": "./gradlew classes",
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.java",
        "vmware.vscode-spring-boot",
        "redhat.vscode-yaml",
        "EditorConfig.EditorConfig",
        "anthropic.claude-code"
      ],
      "settings": {
        "java.jdt.ls.java.home": "/opt/java/openjdk",
        "java.configuration.updateBuildConfiguration": "automatic",
        "editor.formatOnSave": true,
        "[java]": {
          "editor.formatOnSave": false
        },
        "files.exclude": {
          "**/.gradle": true,
          "**/build": true
        }
      }
    }
  }
}
