{
  "dockerComposeFile": [
    "../compose.yml"
  ],
  "service": "api",
  "runServices": [
    "api",
    "db"
  ],
  "workspaceFolder": "/app",
  "mounts": [
    "source=claude-config,target=/home/ubuntu/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/ubuntu/.claude"
  },
  "remoteUser": "ubuntu",
  "shutdownAction": "stopCompose",
  "forwardPorts": [
    8080,
    5432
  ],
  "portsAttributes": {
    "8080": {
      "label": "API",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "git config --global --add safe.directory /app && ./gradlew clean classes",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle",
        "vmware.vscode-boot-dev-pack",
        "ms-azuretools.vscode-docker",
        "cweijan.vscode-postgresql-client2",
        "redhat.vscode-yaml",
        "EditorConfig.EditorConfig",
        "anthropic.claude-code"
      ],
      "settings": {
        "java.jdt.ls.java.home": "/opt/java/openjdk",
        "java.configuration.updateBuildConfiguration": "automatic",
        "java.import.gradle.wrapper.enabled": true,
        "editor.formatOnSave": true,
        "[java]": {
          "editor.formatOnSave": false
        },
        "files.eol": "\n",
        "files.exclude": {
          "**/.gradle": true,
          "**/build": true
        }
      }
    }
  }
}